{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/ebb/schemas/source-heal.v1.schema.json",
  "title": "Ebb Source Heal Report v1",
  "description": "Schema for source repair reports generated by tools/source-heal/.",
  "type": "object",
  "required": [
    "schemaVersion",
    "healedAt",
    "oldUrl",
    "failures",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ebb.source-heal.v1"
    },
    "healedAt": {
      "type": "string"
    },
    "oldUrl": {
      "type": "string"
    },
    "ruleIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "error"],
        "properties": {
          "timestamp": { "type": "string" },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "candidate": {
      "type": ["object", "null"],
      "required": ["type", "url", "method", "dateFound"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["relocated", "archive"]
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "dateFound": {
          "type": "boolean"
        },
        "archivedAt": {
          "type": "string"
        },
        "snippetHash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": ["relocate", "archive", "unresolved"]
    }
  }
}
