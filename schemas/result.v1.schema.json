{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/ebb/schemas/result.v1.schema.json",
  "title": "Ebb lifecycle result v1",
  "description": "Output of checking one component version against active Ebb lifecycle rules. See docs/result-model.md.",
  "type": "object",
  "required": ["schemaVersion", "status", "matches", "version"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "$ref": "#/$defs/status" },
    "matches": {
      "type": "array",
      "items": { "$ref": "#/$defs/match" }
    },
    "version": { "$ref": "#/$defs/nonEmpty" },
    "asOf": { "$ref": "#/$defs/date" },
    "extendedSupportUntil": {
      "description": "Final date of vendor-backed extended or commercial support (YYYY-MM-DD).",
      "$ref": "#/$defs/date"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": { "properties": { "matches": { "type": "array", "maxItems": 0 } } },
      "else": { "properties": { "matches": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "enum": ["ok", "deprecated", "unsupported", "end-of-life", "removed", "scheduled"]
    },
    "event": {
      "enum": ["deprecated", "unsupported", "end-of-life", "removed", "scheduled"]
    },
    "match": {
      "type": "object",
      "required": ["ruleId", "event", "date", "daysLeft", "replacement", "sources", "reviewedAt"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "event": { "$ref": "#/$defs/event" },
        "date": {
          "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
        },
        "datePrecision": {
          "description": "Vendor announcement precision. month when the rule carries x-*.endOfLifeMonth.",
          "enum": ["day", "month"]
        },
        "daysLeft": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "replacement": {
          "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
        },
        "replacements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["purl", "name", "kind"],
            "additionalProperties": false,
            "properties": {
              "purl": { "type": "string" },
              "vers": { "type": "string" },
              "name": { "type": "string" },
              "kind": { "enum": ["successor", "alternative", "upgrade"] },
              "note": { "type": "string" }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "reviewedAt": { "$ref": "#/$defs/date" },
        "confidence": {
          "description": "How far this rule match can be trusted: confirmed, likely, or tentative.",
          "enum": ["confirmed", "likely", "tentative"]
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/nonEmpty" },
        "url": { "type": "string", "pattern": "^https://" },
        "accessedAt": { "$ref": "#/$defs/date" },
        "archiveUrl": { "type": "string", "pattern": "^https://" },
        "archivedAt": { "$ref": "#/$defs/date" },
        "pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
