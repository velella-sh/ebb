{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/ebb/schemas/static-api.v1.schema.json",
  "title": "Ebb static lifecycle API v1",
  "description": "The static JSON documents served under api/v1/: components, ecosystems, all rules, search index, upcoming deadlines, recent changes, and the global index.",
  "oneOf": [
    { "$ref": "#/$defs/componentDocument" },
    { "$ref": "#/$defs/ecosystemDocument" },
    { "$ref": "#/$defs/allDocument" },
    { "$ref": "#/$defs/indexDocument" },
    { "$ref": "#/$defs/ecosystemsDocument" },
    { "$ref": "#/$defs/upcomingDocument" },
    { "$ref": "#/$defs/recentDocument" },
    { "$ref": "#/$defs/searchIndexDocument" },
    { "$ref": "#/$defs/metaDocument" },
    { "$ref": "#/$defs/ruleDocument" },
    { "$ref": "#/$defs/releasesDocument" }
  ],
  "$defs": {
    "rule": { "$ref": "registry.v2.schema.json#/$defs/rule" },
    "componentDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "purl", "type", "name", "ecosystems", "rules"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "purl": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "ecosystems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "hint": { "type": "string", "deprecated": true, "description": "Deprecated. No longer written; kept so older files still validate." },
        "calendar": { "type": "string" },
        "renovate": { "type": "string" },
        "versions": { "$ref": "#/$defs/versionsSection" },
        "replacements": {
          "type": "array",
          "items": { "$ref": "#/$defs/replacementItem" }
        }
      }
    },
    "replacementItem": {
      "type": "object",
      "required": ["purl", "name", "kind"],
      "additionalProperties": false,
      "properties": {
        "purl": {
          "type": "string",
          "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^@?#\\s]+$"
        },
        "vers": {
          "type": "string",
          "pattern": "^vers:[a-z][a-z0-9.+-]*/\\S+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["successor", "alternative", "upgrade"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "versionsSection": {
      "type": "object",
      "required": ["asOf", "complete", "reason", "recommendation", "notes", "lines"],
      "additionalProperties": false,
      "properties": {
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "complete": { "type": "boolean" },
        "reason": { "type": "string" },
        "recommendation": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["lineId", "reason"],
              "additionalProperties": false,
              "properties": {
                "lineId": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "vers", "status", "endDate", "ruleId", "event"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "vers": { "type": "string" },
              "status": { "enum": ["ended", "ending", "no-known-end"] },
              "endDate": { "type": ["string", "null"] },
              "ruleId": { "type": "string" },
              "event": { "type": "string" }
            }
          }
        }
      }
    },
    "ecosystemDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "ecosystem", "rulesCount", "componentsCount", "rules"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "ecosystem": { "type": "string" },
        "rulesCount": { "type": "integer", "minimum": 0 },
        "componentsCount": { "type": "integer", "minimum": 0 },
        "provenance": {
          "type": "object",
          "required": ["methods", "reviewersCount"],
          "additionalProperties": false,
          "properties": {
            "methods": {
              "type": "object",
              "required": ["manual", "imported", "upstream"],
              "additionalProperties": false,
              "properties": {
                "manual": { "type": "integer", "minimum": 0 },
                "imported": { "type": "integer", "minimum": 0 },
                "upstream": { "type": "integer", "minimum": 0 }
              }
            },
            "reviewersCount": { "type": "integer", "minimum": 0 }
          }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "allDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "rulesCount", "componentsCount", "ecosystemsCount", "rules"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "rulesCount": { "type": "integer", "minimum": 0 },
        "componentsCount": { "type": "integer", "minimum": 0 },
        "ecosystemsCount": { "type": "integer", "minimum": 0 },
        "rawBytes": { "type": "integer", "minimum": 0 },
        "gzipBytes": { "type": "integer", "minimum": 0 },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "indexComponent": {
      "type": "object",
      "required": ["purl", "type", "name", "path", "url", "ecosystems", "events", "rules", "sha256", "etag", "bytes"],
      "additionalProperties": false,
      "properties": {
        "purl": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "ecosystems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "events": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": { "type": "integer", "minimum": 0 },
        "earliestDeadline": { "type": "string" },
        "latestReview": { "type": "string" },
        "renovate": { "type": "string" },
        "card": {
          "type": "object",
          "required": ["path", "sha256", "bytes"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^cards/.+\\.svg$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "etag": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "indexDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "rulesCount", "componentsCount", "ecosystemsCount", "components"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "rulesCount": { "type": "integer", "minimum": 0 },
        "componentsCount": { "type": "integer", "minimum": 0 },
        "ecosystemsCount": { "type": "integer", "minimum": 0 },
        "freshness": {
          "type": "object",
          "required": ["reviewedThrough", "ageDays", "stale", "staleAfterDays"],
          "additionalProperties": false,
          "properties": {
            "reviewedThrough": { "type": "string" },
            "ageDays": { "type": "integer", "minimum": 0 },
            "stale": { "type": "boolean" },
            "staleAfterDays": { "type": "integer", "minimum": 0 }
          }
        },
        "predictions": {
          "type": "object",
          "required": ["path", "sha256", "dataVersion"],
          "additionalProperties": false,
          "properties": {
            "path": { "const": "predictions.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "dataVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" }
          }
        },
        "imageVariants": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": { "const": "image-variants.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "codenames": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": { "const": "codenames.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/indexComponent" }
        }
      }
    },
    "ecosystemsDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "ecosystemsCount", "ecosystems"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "ecosystemsCount": { "type": "integer", "minimum": 0 },
        "ecosystems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path", "url", "rulesCount", "componentsCount"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "url": { "type": "string" },
              "rulesCount": { "type": "integer", "minimum": 0 },
              "componentsCount": { "type": "integer", "minimum": 0 },
              "provenance": {
                "type": "object",
                "required": ["methods", "reviewersCount"],
                "additionalProperties": false,
                "properties": {
                  "methods": {
                    "type": "object",
                    "required": ["manual", "imported", "upstream"],
                    "additionalProperties": false,
                    "properties": {
                      "manual": { "type": "integer", "minimum": 0 },
                      "imported": { "type": "integer", "minimum": 0 },
                      "upstream": { "type": "integer", "minimum": 0 }
                    }
                  },
                  "reviewersCount": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "upcomingItem": {
      "type": "object",
      "required": ["ruleId", "purl", "ecosystem", "event", "title", "path"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string" },
        "purl": { "type": "string" },
        "ecosystem": { "type": "string" },
        "event": { "type": "string" },
        "title": { "type": "string" },
        "deadline": { "type": "string" },
        "severity": { "type": "string" },
        "replacement": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "upcomingDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "count", "upcoming"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "upcoming": {
          "type": "array",
          "items": { "$ref": "#/$defs/upcomingItem" }
        }
      }
    },
    "recentItem": {
      "type": "object",
      "required": ["ruleId", "purl", "ecosystem", "event", "title", "path"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string" },
        "purl": { "type": "string" },
        "ecosystem": { "type": "string" },
        "event": { "type": "string" },
        "title": { "type": "string" },
        "deadline": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "observedAt": { "type": "string" },
        "severity": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "recentDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "count", "recent"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "recent": {
          "type": "array",
          "items": { "$ref": "#/$defs/recentItem" }
        }
      }
    },
    "searchIndexDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "items", "prefixes"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "purl", "path"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "purl": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        },
        "prefixes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "metaDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "dataVersion", "rulesCount", "componentsCount", "ecosystemsCount", "schemaVersions"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "dataVersion": { "type": "string" },
        "rulesCount": { "type": "integer", "minimum": 0 },
        "componentsCount": { "type": "integer", "minimum": 0 },
        "ecosystemsCount": { "type": "integer", "minimum": 0 },
        "schemaVersions": {
          "type": "object",
          "required": ["api", "rule", "result"],
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "integer" }]
          },
          "properties": {
            "api": { "type": "string" },
            "rule": { "type": "string" },
            "result": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "registry": { "type": "string" }
          }
        }
      }
    },
    "ruleDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "rule"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "rule": { "$ref": "#/$defs/rule" }
      }
    },
    "releaseCounts": {
      "type": "object",
      "required": ["added", "changed", "removed"],
      "additionalProperties": false,
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "releaseItem": {
      "type": "object",
      "required": ["version", "date", "digest", "counts", "url"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "date": { "type": "string" },
        "digest": { "type": "string" },
        "counts": { "$ref": "#/$defs/releaseCounts" },
        "url": { "type": "string" }
      }
    },
    "releasesDocument": {
      "type": "object",
      "required": ["schemaVersion", "version", "generatedAt", "count", "releases"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "ebb.api.v1" },
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "releases": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseItem" }
        }
      }
    }
  }
}
