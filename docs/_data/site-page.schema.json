{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "slug", "title", "summary", "purl", "dataVersion", "deadline", "precision", "claims"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "purl": { "type": "string", "pattern": "^pkg:" },
    "dataVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$" },
    "deadline": { "type": ["string", "null"] },
    "precision": { "enum": ["day", "month", "No published date"] },
    "claims": { "type": "object" },
    "ecosystem": { "type": "string" },
    "ruleCount": { "type": "integer", "minimum": 1 },
    "releaseLines": { "type": "array", "items": { "type": "string" } },
    "product": { "type": "string" },
    "line": { "type": "string" },
    "vers": { "type": "string" },
    "ruleId": { "type": ["string", "null"] },
    "status": { "enum": ["ended", "ending", "no-known-end"] }
  },
  "oneOf": [
    { "required": ["ecosystem", "ruleCount", "releaseLines"] },
    { "required": ["product", "line", "vers", "ruleId", "status"] }
  ]
}
