{
  "name": "@velella/ebb",
  "version": "0.2.0",
  "description": "The open almanac of software end-of-life.",
  "keywords": [
    "end-of-life",
    "eol",
    "deprecation",
    "lifecycle",
    "purl",
    "vers",
    "registry"
  ],
  "homepage": "https://github.com/velella-sh/ebb#readme",
  "bugs": {
    "url": "https://github.com/velella-sh/ebb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/ebb.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "ebb": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/browser.js",
      "worker": "./dist/src/browser.js",
      "workerd": "./dist/src/browser.js",
      "edge-light": "./dist/src/browser.js",
      "import": "./dist/src/index.js",
      "require": "./dist/src/cjs-error.cjs"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js",
      "default": "./dist/src/browser.js"
    },
    "./edge": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js",
      "default": "./dist/src/browser.js"
    },
    "./verify": {
      "types": "./dist/src/verify.d.ts",
      "import": "./dist/src/verify.js",
      "default": "./dist/src/verify.js"
    },
    "./data/loader": {
      "types": "./dist/src/data/loader.d.ts",
      "import": "./dist/src/data/loader.js",
      "default": "./dist/src/data/loader.js"
    },
    "./data/load": {
      "types": "./dist/src/data/load.d.ts",
      "import": "./dist/src/data/load.js",
      "default": "./dist/src/data/load.js"
    },
    "./data/bundled-data": {
      "types": "./dist/src/data/bundled-data.d.ts",
      "import": "./dist/src/data/bundled-data.js",
      "default": "./dist/src/data/bundled-data.js"
    },
    "./data/bundled-loader": {
      "types": "./dist/src/data/bundled-loader.d.ts",
      "import": "./dist/src/data/bundled-loader.js",
      "default": "./dist/src/data/bundled-loader.js"
    },
    "./data/ecosystems": {
      "types": "./dist/src/data/ecosystems.d.ts",
      "import": "./dist/src/data/ecosystems.js",
      "default": "./dist/src/data/ecosystems.js"
    },
    "./data/ecosystems/*": {
      "types": "./dist/src/data/ecosystems/*.d.ts",
      "import": "./dist/src/data/ecosystems/*.js",
      "default": "./dist/src/data/ecosystems/*.js"
    },
    "./data/*": {
      "types": "./dist/src/data/ecosystems/*.d.ts",
      "import": "./dist/src/data/ecosystems/*.js",
      "default": "./dist/src/data/ecosystems/*.js"
    },
    "./create": {
      "types": "./dist/src/create.d.ts",
      "import": "./dist/src/create.js",
      "default": "./dist/src/create.js"
    },
    "./registry/*": "./registry/*",
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "data",
    "registry",
    "schemas",
    "skills",
    "llms.txt",
    "llms-full.txt",
    "LICENSE",
    "LICENSE-DATA",
    "ATTRIBUTION.md",
    "!registry/sources.lock.json",
    "!**/*.map"
  ],
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); fs.mkdirSync('packages/mcp/node_modules/@velella', {recursive: true}); try { fs.symlinkSync('../../../..', 'packages/mcp/node_modules/@velella/ebb', 'junction'); } catch {}\"",
    "build:mcp": "node -e \"const fs=require('fs'); fs.mkdirSync('packages/mcp/node_modules/@velella', {recursive: true}); try { fs.symlinkSync('../../../..', 'packages/mcp/node_modules/@velella/ebb', 'junction'); } catch {}\" && tsc -b packages/mcp/tsconfig.json",
    "build": "tsc -b tsconfig.json && npm run build:mcp && node dist/tools/annotate-jsr-types.js",
    "build:ecosystems": "node dist/tools/build-ecosystem-modules.js",
    "build:llms": "npm run build --silent && node dist/tools/build-llms.js",
    "build:static-api": "npm run build --silent && node dist/tools/static-api/index.js",
    "eval:agents": "npm run build --silent && node dist/tools/eval-agents.js",
    "test": "npm run build --silent && node --test \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build --silent && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"dist/tests/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"dist/tests/**/*.test.js\"",
    "coverage:badge": "node dist/tools/coverage-badge.js coverage/lcov.info coverage/coverage.json",
    "badges": "npm run build --silent && node dist/tools/badges.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "api": "npm run build --silent && mkdir -p api && api-extractor run --local",
    "api:check": "npm run build --silent && api-extractor run --print-api-report-diff",
    "lint:rules": "npm run build --silent && node dist/tools/changed-rules.js --all",
    "check": "npm run format:check && npm test",
    "bench": "npm run build --silent && node --input-type=module -e \"import { runAllBenchmarks } from './bench/run.ts'; runAllBenchmarks();\"",
    "check:sources": "npm run build --silent && node dist/tools/check-sources.js",
    "size": "npm run build --silent && node dist/tools/size.js",
    "build:data-bundle": "npm run build --silent && node dist/tools/build-data-bundle.js",
    "prepack": "npm run build --silent && npm run build:llms"
  },
  "engines": {
    "node": ">=22"
  },
  "ebb": {
    "sizeBudget": 500000
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
