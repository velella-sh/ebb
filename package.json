{
  "name": "@velella/ebb",
  "version": "0.1.0",
  "description": "The open almanac of software end-of-life.",
  "keywords": [
    "end-of-life",
    "eol",
    "deprecation",
    "lifecycle",
    "purl",
    "vers",
    "registry"
  ],
  "homepage": "https://github.com/velella-sh/ebb#readme",
  "bugs": {
    "url": "https://github.com/velella-sh/ebb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/ebb.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "data",
    "registry",
    "schemas",
    "LICENSE",
    "LICENSE-DATA",
    "ATTRIBUTION.md",
    "!registry/sources.lock.json",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "npm run build --silent && node --test \"dist/tests/**/*.test.js\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:rules": "npm run build --silent && node dist/tools/changed-rules.js --all",
    "check": "npm run format:check && npm test",
    "check:sources": "npm run build --silent && node dist/tools/check-sources.js",
    "build:data-bundle": "npm run build --silent && node dist/tools/build-data-bundle.js",
    "prepack": "npm run build --silent"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/verify": "^4.1.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
