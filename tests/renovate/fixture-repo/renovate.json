{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    "ebb": {
      "defaultRegistryUrlTemplate": "file://node.json",
      "format": "json"
    }
  },
  "packageRules": [
    {
      "matchPackageNames": ["node", "library/node"],
      "overrideDatasource": "custom.ebb",
      "versioning": "loose"
    }
  ]
}
