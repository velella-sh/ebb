{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.velella-sh/ebb",
  "title": "Ebb Lifecycle & Deprecation",
  "description": "Check package end-of-life, deprecations, replacements, and upcoming deadlines offline.",
  "version": "0.3.0",
  "websiteUrl": "https://velella.sh/ebb",
  "repository": {
    "url": "https://github.com/velella-sh/ebb",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@velella/ebb",
      "version": "0.3.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": ["check", "check_all", "diff", "pick_version", "replacement_for", "sources_of"]
    }
  }
}
